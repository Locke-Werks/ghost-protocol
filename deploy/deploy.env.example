# Copy to deploy/deploy.env and fill in. That file is gitignored: it names your
# host and your public address, and neither belongs in a repository.
#
# provision.sh and deploy.sh both read it.

# Where to ssh. A hostname, an ssh_config alias, or an address.
DEPLOY_HOST=your-host.example.com

# Key to authenticate with.
SSH_KEY=~/.ssh/id_ed25519

# The public name the relay answers on. DNS for it must already point at the
# host; Caddy issues the certificate on first request.
GHOST_VHOST=ghost.example.com

# The host's own public address. It goes into deny_addresses in the config so
# the relay cannot be pointed back at the reverse proxy in front of it and used
# to loop through whatever else that proxy serves. Leaving it unset is a real
# gap, not a formality.
GHOST_PUBLIC_IP=203.0.113.10
