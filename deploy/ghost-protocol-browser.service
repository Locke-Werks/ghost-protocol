# Ghost Protocol browser process.
#
# The component that renders attacker-controlled pages, run as `ghostbrowser`:
# an account that owns nothing. It cannot read /etc/ghost-protocol, has no
# Postgres role, and holds no key. If a page ever achieves code execution here,
# it lands somewhere with nothing to take and nothing to escalate through.
#
# That split is the reason this is a separate unit rather than a child process
# of the MCP service. In one process, a renderer escape would land on the
# account holding the database password and the OAuth signing key.
#
# ---------------------------------------------------------------------------
# DEVIATIONS from the house hardening block, all four load-bearing:
#
#   1. RestrictNamespaces is a permit-list rather than `yes`.
#   2. SystemCallFilter is a denylist rather than the house `@system-service`
#      allowlist.
#
#      Chrome's own sandbox is built from user, PID, network and mount
#      namespaces plus seccomp-bpf, and it constructs that sandbox by mounting
#      inside its private mount namespace. Any allowlist tight enough to be
#      worth having kills it: @system-service excludes @mount, so the zygote
#      cannot build the sandbox and dies with "Zygote process exited
#      prematurely", and it excludes ptrace, which crashpad needs. Measured on
#      this host, every allowlist variant failed and @mount was the specific
#      cause.
#
#      Chrome's response to being unable to build its sandbox is to refuse to
#      start, and the usual fix at that point is --no-sandbox. That is the
#      wrong trade every time and especially here, since it would remove the
#      only boundary between a compromised renderer and this account.
#
#      So the filter denies the dangerous families instead and lets Chrome's
#      own seccomp-bpf do the fine-grained work inside each renderer, which is
#      what it is for. The empty CapabilityBoundingSet below already makes
#      module loading, reboot, swap and raw I/O fail with EPERM regardless, so
#      the denylist is a second lock on those rather than the only one.
#
#   3. MemoryDenyWriteExecute is off. V8 makes written pages executable to run
#      JIT-compiled JavaScript; with the house `yes`, Chrome does not start.
#
#   4. PrivateUsers stays off. It would give this unit its own user namespace,
#      and Chrome then cannot nest its own inside it.
#
# Everything else is tighter than the house block, not looser: no network
# namespace of its own is needed because all egress is forced through the
# guard proxy on loopback, the tree is read-only, and the only writable paths
# are the systemd-managed state and cache directories.
# ---------------------------------------------------------------------------

[Unit]
Description=Ghost Protocol headless Chrome (CDP on 127.0.0.1:17716)
Documentation=https://github.com/Locke-Werks/ghost-protocol
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ghostbrowser
Group=ghostbrowser
Environment=NODE_ENV=production
EnvironmentFile=/etc/ghost-protocol/browser.env
WorkingDirectory=/opt/ghost-protocol/current
ExecStart=/opt/ghost-protocol/runtime/bin/node /opt/ghost-protocol/current/dist/browser-server.js
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

# Chrome's profile and caches. /opt stays read-only to this unit.
StateDirectory=ghost-protocol-browser
CacheDirectory=ghost-protocol-browser
Environment=XDG_CONFIG_HOME=/var/lib/ghost-protocol-browser
Environment=XDG_CACHE_HOME=/var/cache/ghost-protocol-browser
Environment=HOME=/var/lib/ghost-protocol-browser

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
RemoveIPC=yes
UMask=0077
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

# See deviations 1 and 2 above. The namespace names are systemd's own, so it is
# `mnt` and not `mount`: an unrecognised entry makes systemd discard the whole
# line with a warning, which silently leaves namespaces unrestricted.
# Listing every type systemd knows is the same as not restricting anything, and
# systemctl show then reports RestrictNamespaces=no. Chrome's sandbox needs
# these four; uts and cgroup stay denied.
RestrictNamespaces=user pid net mnt
SystemCallFilter=~@module @reboot @swap @raw-io @clock @obsolete @cpu-emulation
PrivateUsers=no

# See deviation 3 above.
MemoryDenyWriteExecute=no

# PrivateDevices is deliberately absent: headless Chrome wants /dev/shm, and
# --disable-dev-shm-usage in the launch flags already moves shared memory into
# the private /tmp this unit gets from PrivateTmp.

# Chrome is the memory hog here. A page that allocates until the OOM
# killer arrives should take this unit down and get restarted, not take the
# database with it.
MemoryMax=4G
MemorySwapMax=0
TasksMax=1024
OOMPolicy=continue

[Install]
WantedBy=multi-user.target
